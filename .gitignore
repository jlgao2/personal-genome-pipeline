# =====================================================================
# CRITICAL: this .gitignore prevents committing personal genotype data
# and clinical findings. DO NOT loosen any of these rules without
# auditing very carefully.
# =====================================================================

# ── Personal genome data (NEVER commit) ──
data/
# …but the carrier tool's small, non-personal reference data IS committed:
!pipeline/carrier/data/
!pipeline/carrier/data/**
genome_*.zip
genome_*.txt
*.23andme.txt
*ancestrydna*.txt
*myheritage*.txt

# ── Stray downloads at project root (Garmin/HealthKit re-uploads, etc.) ──
/export.zip
/db0b9ac9-*.zip
/*_export.zip
/garmin*.zip

# ── Personal medical records / PDFs (NEVER commit) ──
*.pdf
requested_record*

# ── Reference data (multi-GB downloads, regenerate via setup) ──
refs/

# ── Pipeline outputs containing personal findings (NEVER commit) ──
output/raw_findings/
output/qc/
output/pharmcat/
output/action_plan.md
output/genetic_clinical_correlation.md
output/health_summary.md
output/README.md
output/ios_export/
output/findings/
output/annotsv/
# personal PRS percentiles, scores, samplesheet (general docs live in docs/prs/)
output/pgsc_calc/
# ── Couple carrier-screening (personal + partner data) ──
data/partner/
output/carrier/

# ── Dashboard data (contains personal findings — use data.example.js) ──
output/web/js/data.js
output/web/js/data-vitals.js
output/cross_refs.yaml
output/training_context.md
output/health_profile.json
output/media.yaml

# ── Nextflow work dir + scaffolding (sample-derived genotype intermediates) ──
work/
.nextflow/
.nextflow.log*

# ── Logs may contain sample-specific info ──
logs/
*.log

# ── Temp / build artefacts ──
.junk_topmed_indexes/
__pycache__/
*.pyc
*.pyo
.DS_Store
.venv/
venv/
*.egg-info/
.coverage
.pytest_cache/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*~

# ── Plan files / claude scaffolding (this user's specific work) ──
.claude/
**/luminous-dreaming-trinket.md

# ── OS junk ──
Thumbs.db
.AppleDouble
.LSOverride

# ── Allow the marker files for empty dirs ──
!data/.keep
!refs/.keep

# ── BAM-based specialist callers (mtDNA/HLA/CYP2D6/SMN1/Y — personal) ──
output/specialist/
